    "Now when encountering read-only users, the operation will not stop and will be skipped until the addition is completed.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now when encountering read-only users, the operation will not stop and will be skipped until the addition is completed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用ユーザーに遭遇した場合、操作は停止せず、追加が完了するまでスキップされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 읽기 전용 사용자를 만났을 때 작업이 중단되지 않고 추가가 완료될 때까지 건너뜁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遇到只读用户时，操作不会中断，将跳过并继续添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在遇到唯讀使用者時，操作將不會停止，而是跳過直到新增完成。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "現在遇到唯讀使用者時，操作將不會停止，而是跳過直到新增完成。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "現在遇到唯讀用戶時，操作將不會停止，而是跳過直到加入完成。"
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StevePinyin needs access to your contacts to add pinyin for better sorting and searching. All operations are performed locally on your device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "StevePinyin 需要访问你的联系人，以便添加拼音，实现更好的排序和搜索。所有操作均在你的设备本地完成。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "StevePinyin 需要存取您的聯絡人來新增拼音以改善排序和搜尋。所有操作都在您的裝置上本機執行。"
          }
        }
      }
    },
