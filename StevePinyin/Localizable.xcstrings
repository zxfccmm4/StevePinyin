    "privacy_intro_text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your contacts on English iOS system are not properly sorted, try StevePinyin! StevePinyin is your contacts management assistant that can:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "英語システムのiOSで連絡先の並び順に問題がある場合は、Steveピンインをお試しください！Steveピンインは以下のことができる連絡先管理アシスタントです："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영어 iOS 시스템에서 연락처 정렬에 문제가 있다면 Steve병음을 사용해보세요! Steve병음은 다음과 같은 기능을 제공하는 연락처 관리 도우미입니다:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你的联系人在英文 iOS 系统下排序不正确，试试 StevePinyin！StevePinyin 是你的联系人管理助手，可以："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您的英文系統 iOS 通訊錄排序有問題，試試 Steve拼音！Steve拼音是您的通訊錄管理助手，可以："
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您的英文系統 iOS 通訊錄排序有問題，試試 Steve拼音！Steve拼音是您的通訊錄管理助手，可以："
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你的英文系統 iOS 通訊錄排序有問題，試試 Steve拼音！Steve拼音是你的通訊錄管理助手，可以："
          }
        }
      }
    },
    "privacy_protection_text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StevePinyin fully protects your privacy. All operations are performed locally, and your contacts information never leaves your device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steveピンインはあなたのプライバシーを完全に保護します。すべての操作はデバイス内で実行され、連絡先情報が外部に送信されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Steve병음은 귀하의 개인정보를 완벽하게 보호합니다. 모든 작업은 기기 내에서 처리되며 연락처 정보가 외부로 전송되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "StevePinyin 完全保护你的隐私。所有操作均在本地完成，联系人信息绝不离开你的设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Steve拼音完全保護您的隱私。所有操作均在本機完成，您的通訊錄資訊不會離開裝置。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Steve拼音完全保護您的隱私。所有操作均在本機完成，您的通訊錄資訊不會離開裝置。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Steve拼音完全保護你的私隱。所有操作均在本機完成，你的通訊錄資料不會離開裝置。"
          }
        }
      }
    },
