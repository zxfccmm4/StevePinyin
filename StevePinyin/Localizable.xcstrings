    "Now skips contacts that already have avatars, avoiding unnecessary changes": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now skips contacts that already have avatars, avoiding unnecessary changes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既にアバターがある連絡先をスキップし、不要な変更を回避します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 아바타가 있는 연락처를 건너뛰어 불필요한 변경을 방지합니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已自动跳过已有头像的联系人，避免不必要的更改"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現會跳過已有大頭貼的聯絡人，避免不必要的變更"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "現會跳過已有大頭貼的聯絡人，避免不必要的變更"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "現會跳過已有頭像的聯絡人，避免不必要的更改"
          }
        }
      }
    },
    "Now supports batch avatar uploads for contacts, improving contact management efficiency": {
      "extractionState": "stale",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、連絡先アバターの一括アップロードに対応しており、連絡先管理の効率が向上します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 연락처 아바타 일괄 업로드를 지원하여 연락처 관리 효율성을 향상시킵니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在支援批次上傳聯絡人頭像，提升聯絡人管理效率"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "現在支持批量上傳聯絡人頭像，提高聯絡人管理效率"
          }
        }
      }
    },
